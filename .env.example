# ==========================================
# AIFactoryBox Environment Configuration
# ==========================================

# LiteLLM Proxy Security
LITELLM_MASTER_KEY=sk-change-this-to-a-secure-master-key

# PostgreSQL Control Plane Database
POSTGRES_USER=litellm
POSTGRES_PASSWORD=generate_a_secure_postgres_password
POSTGRES_DB=litellm_db

# External Provider API Keys (optional if running purely local models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
