# Copy to .env and replace all placeholders. Never commit real credentials.
LITELLM_MASTER_KEY=sk-replace-with-a-random-admin-key
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
# Optional: required only for the chat-small cloud model.
OPENAI_API_KEY=
# Initially a nonempty placeholder lets Compose start. Generate a virtual key
# through LiteLLM /key/generate, then replace this and recreate open-webui.
WEBUI_LITELLM_API_KEY=replace-with-a-generated-virtual-key
