# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/presidio-analyzer:2.2.360
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    poetry run pip install --no-cache-dir \
    https://github.com/explosion/spacy-models/releases/download/it_core_news_sm-3.8.0/it_core_news_sm-3.8.0-py3-none-any.whl \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
COPY nlp.yaml /app/conf/nlp.yaml
COPY analyzer.yaml /app/conf/analyzer.yaml
