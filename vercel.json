{
  "version": 2,
  "rewrites": [
    {
    "source": "/(v1/.*|health|status|docs|openapi.json|console/?)",
    "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/website/$1"
    }
  ]
}
