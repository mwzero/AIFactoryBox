{
  "version": 2,
  "rewrites": [
    {
      "source": "/(v1/.*|health|docs|openapi.json)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/console",
      "destination": "/orchestrator/console.html"
    },
    {
      "source": "/(.*)",
      "destination": "/website/$1"
    }
  ]
}
